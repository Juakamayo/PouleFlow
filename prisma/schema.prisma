generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  MIXED
}

enum WeaponName {
  EPEE
  FOIL
  SABER
}

enum BoutStatus {
  COMPLETED    // Asalto terminado normalmente (por tiempo o puntaje)
  ABANDONMENT  // Retiro por lesión
  EXCLUSION    // Tarjeta negra
  MEDICAL      // Retiro médico antes de iniciar
}

model Country {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  iocCode String   @unique
  clubs   Club[]
  fencers Fencer[]
  referees Referee[]
}

model Club {
  id        Int      @id @default(autoincrement())
  name      String
  shortCode String   @unique
  countryId Int
  country   Country  @relation(fields: [countryId], references: [id])
  fencers   Fencer[]

  @@unique([name, countryId])
}

model Fencer {
  id                  Int                @id @default(autoincrement())
  firstName           String
  lastName            String
  clubId              Int?
  club                Club?              @relation(fields: [clubId], references: [id])
  countryId           Int
  country             Country            @relation(fields: [countryId], references: [id])
  nationalRank        Int?
  internationalRank   Int?
  points              Float              @default(0)
  registrations       Registration[]
  poolAssignments     PoolAssignment[]
  boutsAsA            PoolBout[]         @relation("BoutFencerA")
  boutsAsB            PoolBout[]         @relation("BoutFencerB")
  boutsWon            PoolBout[]         @relation("BoutWinner")
  bracketMatchesAsA   BracketMatch[]     @relation("MatchFencerA")
  bracketMatchesAsB   BracketMatch[]     @relation("MatchFencerB")
  bracketMatchesWon   BracketMatch[]     @relation("MatchWinner")

  @@index([lastName, firstName])
}

model Referee {
  id             Int            @id @default(autoincrement())
  firstName      String
  lastName       String
  countryId      Int
  country        Country        @relation(fields: [countryId], references: [id])
  pools          Pool[]
  bracketMatches BracketMatch[]
}

model Weapon {
  id     Int        @id @default(autoincrement())
  name   WeaponName @unique
  events Event[]
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  events Event[]
}

model Tournament {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  location  String?
  events    Event[]
}

model Event {
  id            Int            @id @default(autoincrement())
  tournamentId  Int
  tournament    Tournament     @relation(fields: [tournamentId], references: [id])
  weaponId      Int
  weapon        Weapon         @relation(fields: [weaponId], references: [id])
  categoryId    Int
  category      Category       @relation(fields: [categoryId], references: [id])
  gender        Gender
  registrations Registration[]
  pools         Pool[]
  tableaus      Tableau[]

  @@unique([tournamentId, weaponId, categoryId, gender])
}

model Registration {
  id        Int    @id @default(autoincrement())
  eventId   Int
  event     Event  @relation(fields: [eventId], references: [id])
  fencerId  Int
  fencer    Fencer @relation(fields: [fencerId], references: [id])
  seedRank  Int?

  @@unique([eventId, fencerId])
}

model Pool {
  id           Int               @id @default(autoincrement())
  eventId      Int
  event        Event             @relation(fields: [eventId], references: [id])
  poolNumber   Int
  pisteNumber  Int?
  refereeId    Int?
  referee      Referee?          @relation(fields: [refereeId], references: [id])
  assignments  PoolAssignment[]
  bouts        PoolBout[]

  @@unique([eventId, poolNumber])
}

model PoolAssignment {
  id              Int    @id @default(autoincrement())
  poolId          Int
  pool            Pool   @relation(fields: [poolId], references: [id])
  fencerId        Int
  fencer          Fencer @relation(fields: [fencerId], references: [id])

  // Cache de índices calculados tras cargar los resultados de la poule.
  // Se recalculan cada vez que se registra/edita un PoolBout de esta poule,
  // evitando tener que sumar todos los bouts en cada consulta de clasificación.
  victories       Int    @default(0) // V — victorias
  touchesScored   Int    @default(0) // HS — toques dados (hits scored)
  touchesReceived Int    @default(0) // HR — toques recibidos (hits received)
  indicator       Int    @default(0) // Ind — HS - HR

  @@unique([poolId, fencerId])
}

model PoolBout {
  id         Int        @id @default(autoincrement())
  poolId     Int
  pool       Pool       @relation(fields: [poolId], references: [id])
  boutOrder  Int        // Orden fijo del asalto dentro de la poule (1, 2, 3...), define a quién llamar y cuándo
  fencerAId  Int
  fencerA    Fencer     @relation("BoutFencerA", fields: [fencerAId], references: [id])
  fencerBId  Int
  fencerB    Fencer     @relation("BoutFencerB", fields: [fencerBId], references: [id])
  scoreA     Int
  scoreB     Int
  winnerId   Int?
  winner     Fencer?    @relation("BoutWinner", fields: [winnerId], references: [id])
  status     BoutStatus @default(COMPLETED)

  @@unique([poolId, fencerAId, fencerBId])
  @@unique([poolId, boutOrder])
}

model Tableau {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(DateTime.now())
  updatedAt    DateTime @updatedAt

  eventId      Int
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  size         Int
  
  roundConfigs Json     @default("{}")

  bracketMatches BracketMatch[]
}

model BracketMatch {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(DateTime.now())
  updatedAt     DateTime @updatedAt

  tableauId     Int
  tableau       Tableau  @relation(fields: [tableauId], references: [id], onDelete: Cascade)

  round         Int
  position      Int

  fencerAId     Int?
  fencerA       Fencer?  @relation("FencerA", fields: [fencerAId], references: [id])

  fencerBId     Int?
  fencerB       Fencer?  @relation("FencerB", fields: [fencerBId], references: [id])

  winnerId      Int?
  winner        Fencer?  @relation("Winner", fields: [winnerId], references: [id])

  scoreA        Int         @default(0)
  scoreB        Int         @default(0)
  status        BoutStatus  @default(PENDING)
  

  targetTouches Int         @default(15)
}
